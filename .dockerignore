# Local virtualenv — must NOT be copied into the image.
# It contains a python symlink to the host interpreter (/usr/bin/python3.11),
# which breaks `uv sync` inside the python3.14 image.
.venv/
venv/
env/

# NOTE: .git is intentionally NOT ignored — setuptools_scm reads it at build
# time to compute the package version (see [tool.setuptools_scm] in pyproject.toml).

# Python build artifacts / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/

# Local env / editor / OS files
.env
.env.*
*.log
.DS_Store
.idea/
.vscode/

# Docker / compose files (not needed inside the image)
Dockerfile
.dockerignore
docker-compose*.yml
